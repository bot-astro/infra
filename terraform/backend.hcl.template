# Copy to backend.hcl (gitignored) and fill in. Pass it with: terraform init -backend-config=../backend.hcl
# The R2 bucket must exist already (created by hand once), and the R2 API token credentials are read from
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
bucket = "astro-terraform-state"
endpoints = {
  s3 = "https://<cloudflare_account_id>.r2.cloudflarestorage.com"
}
